{
  "realm": "qhalimenu",
  "enabled": true,
  "displayName": "QhaliMenu",
  "loginTheme": "qhalimenu",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      { "name": "CLIENTE", "description": "Cliente que reserva almuerzo" },
      { "name": "ADMIN", "description": "Administrador del comedor" },
      { "name": "CAJA", "description": "Personal de caja que entrega o cancela pedidos pagados" }
    ]
  },
  "clients": [
    {
      "clientId": "qhalimenu-frontend",
      "name": "QhaliMenu Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://127.0.0.1:4200/*"
      }
    }
  ],
