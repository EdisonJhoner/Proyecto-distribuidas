        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "aplicacion (logs)",
        "multi": true,
        "name": "application",
        "options": [],
        "query": "label_values(application)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
